# Owner photo storage: demo stores photos in this browser; supabase uses your project.
VITE_DATA_MODE=demo
# Get these values from your own new Supabase project (Project Settings → API).
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Required by existing admin server function; NEVER prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_SERVICE_ROLE_KEY
# Required to enable safe customer image uploads on /gifts:
VITE_TURNSTILE_SITE_KEY=YOUR_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY
# Configure TURNSTILE_SECRET_KEY & ALLOWED_SITE_ORIGINS in Supabase Edge Function secrets, not here.

# Canonical production URL after selecting your own domain
VITE_PUBLIC_SITE_URL=https://YOUR-DOMAIN.example
